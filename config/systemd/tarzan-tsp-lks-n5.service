[Unit]
Description=TARZAN TSP Server with LKS-N5 Nextion 5 status lamp
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

# TARZAN LKS-TTY owns /dev/tty1. Linux getty/login must not write to the same screen.

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tarzan
ExecStart=/usr/bin/python3 /opt/tarzan/main.py
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=8
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
